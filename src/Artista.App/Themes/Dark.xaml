<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme palette. Every brush key here must also exist in Light.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1F1F23"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FF333338"/>
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FF252529"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF313136"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF3E3E45"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF46464E"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#FF2F4A66"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF45454C"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="#FFA8A8B0"/>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#FF6A6A72"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3D8FDD"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#FF2A5F94"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#553D8FDD"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF252528"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#FF2C2C31"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#FF3A3A42"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FF55555E"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FF6A6A75"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FF29292D"/>
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="IconBrush" Color="#FFD8D8DC"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFCE5959"/>

    <Color x:Key="CheckerLightColor">#FF404046</Color>
    <Color x:Key="CheckerDarkColor">#FF313136</Color>
</ResourceDictionary>
