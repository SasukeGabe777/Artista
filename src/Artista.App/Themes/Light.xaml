<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette. Every brush key here must also exist in Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF2F2F4"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFAFAFB"/>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#FFEBEBEE"/>
    <SolidColorBrush x:Key="CanvasSurroundBrush" Color="#FFC9CDD4"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFE3EEF9"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFD3E4F5"/>
    <SolidColorBrush x:Key="ControlCheckedBrush" Color="#FFCCE4F7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFC5C5CC"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FFDBDBE0"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1B1B1F"/>
    <SolidColorBrush x:Key="ForegroundDimBrush" Color="#FF5C5C66"/>
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#FFA0A0A8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0F6CBD"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#FF6CA9DD"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#550F6CBD"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFF2F2F4"/>
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#FFFBFBFC"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFF2F2F4"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFF2F2F4"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#FFE8E8EB"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FFBFBFC6"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#FFA5A5AE"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FFEDEDF0"/>
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#FFFDFDFE"/>
    <SolidColorBrush x:Key="IconBrush" Color="#FF33333A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C"/>

    <Color x:Key="CheckerLightColor">#FFFFFFFF</Color>
    <Color x:Key="CheckerDarkColor">#FFCCCCCC</Color>
</ResourceDictionary>
